{
  "name": "a2-video",
  "version": "1.0.0",
  "private": true,
  "description": "Video konten motion UI A2 Automation (Remotion)",
  "scripts": {
    "studio": "remotion studio",
    "stills": "node scripts/render-stills.mjs JamSembilanMalam",
    "stills:a2-umum": "node scripts/render-stills.mjs A2Umum",
    "render": "remotion render JamSembilanMalam out/jam-9-malam-16x9.mp4",
    "render:a2-umum": "remotion render A2Umum out/a2-umum-16x9.mp4",
    "stills:9x16": "node scripts/render-stills.mjs JamSembilanMalam916",
    "stills:a2-umum-9x16": "node scripts/render-stills.mjs A2Umum916",
    "render:9x16": "remotion render JamSembilanMalam916 out/jam-9-malam-9x16.mp4",
    "render:a2-umum-9x16": "remotion render A2Umum916 out/a2-umum-9x16.mp4",
    "stills:satu-pesanan": "node scripts/render-stills.mjs SatuPesanan",
    "render:satu-pesanan": "remotion render SatuPesanan out/satu-pesanan-9x16.mp4",
    "stills:tips-umroh": "node scripts/render-stills.mjs TipsUmroh",
    "render:tips-umroh": "remotion render TipsUmroh out/tips-umroh-9x16.mp4 --concurrency=4",
    "stills:konveksi": "node scripts/render-stills.mjs Konveksi3D",
    "render:konveksi": "remotion render Konveksi3D out/konveksi-3d-9x16.mp4 --concurrency=2",
    "stills:alasan": "node scripts/render-stills.mjs AlasanSayaBikinA2",
    "render:alasan": "remotion render AlasanSayaBikinA2 out/alasan-saya-bikin-a2-9x16.mp4 --concurrency=4",
    "stills:tiga-salah-kaprah": "node scripts/render-stills.mjs TigaSalahKaprah",
    "render:tiga-salah-kaprah": "remotion render TigaSalahKaprah out/tiga-salah-kaprah-otomatisasi-9x16.mp4 --concurrency=4",
    "stills:otomatisasi-resep": "node scripts/render-stills.mjs OtomatisasiSepertiResep",
    "stills:manual-template-otomatis": "node scripts/render-stills.mjs ManualTemplateOtomatis",
    "render:manual-template-otomatis": "remotion render ManualTemplateOtomatis out/manual-template-otomatis-9x16.mp4 --concurrency=4",
    "stills:tiga-hal-waris": "node scripts/render-stills.mjs TigaHalSebelumWaris",
    "render:tiga-hal-waris": "remotion render TigaHalSebelumWaris out/tiga-hal-sebelum-waris-dibagi-9x16.mp4 --concurrency=4",
    "render:otomatisasi-resep": "remotion render OtomatisasiSepertiResep out/otomatisasi-seperti-resep-9x16.mp4 --concurrency=4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/geist-sans": "^5.3.0",
    "@remotion/cli": "^4.0.539",
    "@remotion/fonts": "^4.0.539",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.539"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.539",
    "@remotion/renderer": "^4.0.539",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
