  "kalimat": [
    {"mulai": 0.14, "selesai": 3.81, "teks": "Kalau bisa masak mi instan, kamu sudah paham otomatisasi.", "segmen": [{"mulai": 0.14, "selesai": 1.80, "kata": 5}, {"mulai": 1.97, "selesai": 3.81, "kata": 4}]},
    {"mulai": 4.18, "selesai": 5.24, "teks": "Coba ingat resepnya.", "segmen": [{"mulai": 4.18, "selesai": 5.24, "kata": 3}]},
    {"mulai": 5.64, "selesai": 7.11, "teks": "Pertama, ada pemicu.", "segmen": [{"mulai": 5.64, "selesai": 6.23, "kata": 1}, {"mulai": 6.39, "selesai": 7.07, "kata": 2}]},
    {"mulai": 7.45, "selesai": 8.24, "teks": "Air mendidih.", "segmen": [{"mulai": 7.45, "selesai": 8.21, "kata": 2}]},
    {"mulai": 8.68, "selesai": 10.09, "teks": "Itu tanda untuk mulai.", "segmen": [{"mulai": 8.68, "selesai": 10.09, "kata": 4}]},
    {"mulai": 10.52, "selesai": 11.82, "teks": "Kedua, ada bahan.", "segmen": [{"mulai": 10.52, "selesai": 11.78, "kata": 3}]},
    {"mulai": 12.26, "selesai": 14.02, "teks": "Mi, bumbu, dan air.", "segmen": [{"mulai": 12.27, "selesai": 12.61, "kata": 1}, {"mulai": 12.83, "selesai": 13.32, "kata": 1}, {"mulai": 13.45, "selesai": 14.02, "kata": 2}]},
    {"mulai": 14.43, "selesai": 16.78, "teks": "Di pekerjaan, bahan itu data.", "segmen": [{"mulai": 14.43, "selesai": 15.47, "kata": 2}, {"mulai": 15.72, "selesai": 16.78, "kata": 3}]},
    {"mulai": 17.24, "selesai": 19.34, "teks": "Ketiga, ada langkah berurutan.", "segmen": [{"mulai": 17.24, "selesai": 19.34, "kata": 4}]},
    {"mulai": 19.63, "selesai": 22.17, "teks": "Masukkan mi, tunggu, tuang bumbu.", "segmen": [{"mulai": 19.63, "selesai": 20.40, "kata": 2}, {"mulai": 20.77, "selesai": 21.26, "kata": 1}, {"mulai": 21.57, "selesai": 22.17, "kata": 2}]},
    {"mulai": 22.51, "selesai": 23.95, "teks": "Urutannya selalu sama.", "segmen": [{"mulai": 22.51, "selesai": 23.95, "kata": 3}]},
    {"mulai": 24.40, "selesai": 28.80, "teks": "Otomatisasi itu sesederhana ini: pemicu, bahan, langkah.", "segmen": [{"mulai": 24.40, "selesai": 26.35, "kata": 4}, {"mulai": 26.77, "selesai": 27.34, "kata": 1}, {"mulai": 27.62, "selesai": 28.13, "kata": 1}, {"mulai": 28.38, "selesai": 28.80, "kata": 1}]},
    {"mulai": 29.18, "selesai": 32.14, "teks": "Bedanya, yang menjalankan bukan tanganmu.", "segmen": [{"mulai": 29.18, "selesai": 29.92, "kata": 1}, {"mulai": 30.17, "selesai": 32.14, "kata": 4}]},
    {"mulai": 32.47, "selesai": 35.93, "teks": "Jadi, pekerjaan apa di tempatmu yang urutannya selalu sama?", "segmen": [{"mulai": 32.47, "selesai": 35.93, "kata": 9}]},
